# QuantMind 本地 GPU 训练镜像（在 AutoDL 公共镜像基础上补齐训练依赖）
#
# 基础镜像来自 AutoDL 公共模板（crpi/quant-mind/quantmind:gpu），已含：
#   - torch 2.9.1+cu128（CUDA 版）+ lightgbm/xgboost/catboost/sklearn/scipy/pandas/pyarrow
#   - /root/QuantMind（GitHub 仓库）
#
# 本镜像补齐 qlib（GRU/LSTM 等 Qlib TS 模型必需）、optuna（惰性 import）、
# python 软链，并 COPY 最新 train.py/preprocessing.py + qlib 补丁。
# 生成产物是本地编排器 TRAINING_IMAGE 的 GPU 版，替代 CPU 版 quantmind-oss:latest。

FROM crpi-uyfb721x5vbg2abh.cn-shanghai.personal.cr.aliyuncs.com/quant-mind/quantmind:gpu

# 训练脚本与预处理（每次构建取仓库最新代码）
COPY docker/training/train.py /app/train.py
COPY docker/training/preprocessing.py /app/preprocessing.py

# python 软链：编排器启动命令是 ["python", "/app/train.py", ...]
RUN ln -sf /usr/bin/python3 /usr/local/bin/python

# 补齐训练依赖：qlib（Qlib TS 模型）、optuna（惰性超参搜索）
RUN python3 -m pip install --no-cache-dir \
        --index-url https://mirrors.aliyun.com/pypi/simple/ \
        "pyqlib==0.9.7" "optuna>=3.6.0"

# qlib 0.9.7 bug 修复：position.py 中 price=None 导致 TypeError
COPY docker/patch_qlib.py /tmp/patch_qlib.py
RUN python3 /tmp/patch_qlib.py && rm /tmp/patch_qlib.py

# 验证关键依赖
RUN python3 -c "import torch, qlib, optuna, lightgbm, xgboost, catboost; \
                print('deps OK, cuda:', torch.cuda.is_available())"

WORKDIR /app
