# QuantMind RD-Agent 独立镜像
#
# 设计：从主镜像 quantmind-oss 继承，避免重复安装 PyTorch / qlib / rdagent
# 启动后直接调用 scripts/rd_agent/rd_agent_run.py 跑因子演化
#
# 触发方式：
#   1) docker compose --profile rdagent build rdagent   # 构建
#   2) launcher.py 通过 docker SDK 启动该镜像执行单次任务
#
# 体积优化（可选 future work）：
#   - 改为 python:3.10-slim + pip install rdagent qlib + 拷贝 backend/shared
#   - 当前为了快速可用，直接继承 quantmind-oss

ARG BASE_IMAGE=quantmind-oss:latest
FROM ${BASE_IMAGE}

LABEL com.quantmind.role="rdagent-runner"
LABEL com.quantmind.description="QuantMind RD-Agent 因子演化容器"

# 默认 Qlib 数据路径（启动时 -v 覆盖）
ENV QLIB_PROVIDER_URI=/app/db/qlib_data/cn_data \
    LOG_TRACE_PATH=/tmp/rdagent_logs \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

# 工作目录使用临时区避免污染主镜像 /app
WORKDIR /tmp/rdagent_work

# 健康检查：rdagent 模块可导入
HEALTHCHECK --interval=60s --timeout=10s --retries=2 \
    CMD python -c "import rdagent" || exit 1

ENTRYPOINT ["python", "/app/scripts/rd_agent/rd_agent_run.py"]
CMD ["--dry-run"]
